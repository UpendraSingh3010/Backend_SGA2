# Copy this file to .env and adjust. Every value is optional for local use.

# --- Database ---------------------------------------------------------------
# Leave empty to use a temporary in-memory MongoDB (auto-seeded demo data).
# For a persistent DB / deployment use MongoDB Atlas (free tier) or local MongoDB:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleet?retryWrites=true&w=majority
#   MONGODB_URI=mongodb://127.0.0.1:27017/fleet
MONGODB_URI=mongodb+srv://upendrasingh02005_db_user:yQEbe84IUY8327n8@cluster0.pr0d1pb.mongodb.net/

# --- Security ----------------------------------------------------------------
# CHANGE THESE before deploying (use long random strings)
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=1h
INTERNAL_SERVICE_KEY=dev-only-internal-key

# --- API Gateway -------------------------------------------------------------
# Comma-separated list of valid client API keys (sent in the x-api-key header)
API_KEYS=dev-api-key-123
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
PROXY_TIMEOUT_MS=10000

# Gateway port (PORT is what hosting platforms like Render set)
PORT=8080
USER_SERVICE_PORT=4001
VEHICLE_SERVICE_PORT=4002
TELEMETRY_SERVICE_PORT=4003
MAPS_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

# --- Geolocation ---------------------------------------------------------------
# nominatim = real OpenStreetMap geocoding (needs internet), mock = offline
GEO_PROVIDER=nominatim
NOMINATIM_USER_AGENT=FleetManagementSystem/1.0 (educational project)

# --- SMS -----------------------------------------------------------------------
# stub = custom mock SMS provider (default), twilio = real SMS via Twilio trial
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Critical event thresholds -----------------------------------------------
LOW_BATTERY_THRESHOLD=15
ENGINE_OVERHEAT_THRESHOLD=110
